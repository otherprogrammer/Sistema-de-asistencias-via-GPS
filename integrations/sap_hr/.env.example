# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO: INTEGRACIÓN ASISTENCIA -> SAP HR
# ==============================================================================
# Renombrar este archivo a '.env' y configurar las credenciales corporativas reales.
# IMPORTANTE: NUNCA subir archivos .env con credenciales reales al repositorio.

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase (Origen de Datos)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=flutter-gps-attendance-prod
FIREBASE_DATABASE_ID=(default)
# Ruta al archivo JSON de cuenta de servicio de Google Cloud / Firebase Admin
FIREBASE_CREDENTIALS_PATH=./secrets/firebase_service_account.json
# Clave API para Firestore REST API (opcional si se usa cuenta de servicio)
FIREBASE_API_KEY=AIzaSyAEXAMPLE_KEY_NOT_REAL_000000000
FIREBASE_USE_REST_API=true
FIREBASE_ATTENDANCES_COLLECTION=attendances
FIREBASE_USERS_COLLECTION=users
FIREBASE_WORKSITES_COLLECTION=worksites

# ------------------------------------------------------------------------------
# 2. Configuración de SAP SuccessFactors / SAP HCM (Destino de Datos)
# ------------------------------------------------------------------------------
# URL base del tenant de SAP SuccessFactors (ej. https://api12preview.sapsf.com)
SAP_BASE_URL=https://api-preview.successfactors.com
# Identificador de la compañía en SuccessFactors
SAP_COMPANY_ID=SAPCUST01

# Modo de simulación (DRY_RUN):
# - 'true': Valida y genera los payloads reales de SAP sin transmitir peticiones HTTP salientes.
# - 'false': Envía llamadas reales al endpoint OData v2 'ExternalTimeData' de SAP.
SAP_DRY_RUN=true

# Credenciales OAuth 2.0 (Recomendado para producción)
SAP_CLIENT_ID=sf_time_integration_client
SAP_CLIENT_SECRET=YOUR_SAP_OAUTH_CLIENT_SECRET_HERE
SAP_TOKEN_URL=https://api-preview.successfactors.com/oauth/token

# Credenciales Básicas (Alternativa para desarrollo/testing)
# Formato interno: username@companyId:password
SAP_USERNAME=sf_admin_integration
SAP_PASSWORD=YOUR_SAP_USER_PASSWORD_HERE

# Mapeo de Tipos de Tiempo y Centros de Costo en SAP Time Tracking
SAP_TIME_TYPE_REGULAR=REGULAR_WORK
SAP_TIME_TYPE_OVERTIME=OVERTIME_WORK
SAP_DEFAULT_COST_CENTER=CC_OBRAS_LIMA_01
SAP_TIMEOUT_SECONDS=30
SAP_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# 3. Reglas de Validación y Calidad de Datos
# ------------------------------------------------------------------------------
VAL_MAX_SHIFT_HOURS=16.0
VAL_MIN_SHIFT_HOURS=0.25
VAL_DUPLICATE_WINDOW_MINUTES=5
VAL_REQUIRE_VALID_GEOFENCE=false
VAL_TIMEZONE=America/Lima

# ------------------------------------------------------------------------------
# 4. Configuración de Exportación Local y Auditoría
# ------------------------------------------------------------------------------
EXPORT_OUTPUT_DIR=./exports
EXPORT_CSV_DELIMITER=,
EXPORT_INCLUDE_METADATA=false
